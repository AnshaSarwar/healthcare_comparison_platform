DEBUG=false
ENVIRONMENT=development
AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql+asyncpg://benefits:benefits@localhost:5432/benefits_compare
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6433
QDRANT_COLLECTION=plan_chunks
FRONTEND_BASE_URL=http://localhost:3100
# console: log verification/reset/invite emails instead of sending them. smtp: send via SMTP_*.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@benefits-compare.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
OPENAI_API_KEY=
OLLAMA_BASE_URL=https://subscriptions-persons-emission-thus.trycloudflare.com/v1
OLLAMA_CHAT_MODEL=mistral-small3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_EMBEDDING_DIMENSIONS=768
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
